# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill it in.
# ─────────────────────────────────────────────────────────────

# ── OpenAI — transcript QA (coverage + description) ─────────────
OPENAI_API_KEY=sk-your-key-here
# gpt-5.5 = OpenAI's flagship reasoning ("thinking") model — best QA quality,
# ~$5/M in + $30/M out (~2-3x gpt-4o). gpt-4o = cheaper option.
OPENAI_MODEL=gpt-5.5
# Thinking depth for gpt-5.x/o* models: none|low|medium|high|xhigh (blank = default).
OPENAI_REASONING_EFFORT=high
# true = skip the OpenAI call and stub it (test the pipeline free/offline).
MOCK_OPENAI=false

# ── Input (drop files in ./input, ./trainer) ─────────────────
VIDEO_FILE=session.mp4
# Optional Zoom .vtt in ./input. If blank, the audio is transcribed locally with Whisper.
TRANSCRIPT_FILE=
# Optional trainer reference face in ./trainer. Enables trainer-vs-candidate + swap detection.
TRAINER_IMAGE_FILE=

# ── PRODUCTION PARITY: drop the real training-temp.json in ./input ───────────
# If present, day / trainer / candidate / meeting_id are read FROM IT (overriding the
# manual values below) — exactly like the EC2 worker reads them from the SQS job.
# Leave blank to auto-detect a file literally named "training-temp.json" in ./input.
TRAINING_TEMP_FILE=

# ── Which training day this session is (used ONLY if no training-temp.json) ──
DAY_NUMBER=1

# ── Speaker names (used ONLY if no training-temp.json) ───────
# If blank, the top speaker is assumed to be the trainer.
TRAINER_NAME=
CANDIDATE_NAME=

# ── Video analysis (100% local models, CPU only) ─────────────
# false = transcript track only (fast, no CV) for a first test.
ENABLE_VIDEO_ANALYSIS=true
FRAME_FPS=1
# Annotated "what the models saw" video (face boxes, identity samples, gaze samples)
# written to ./output/analysis-video.mp4 and embedded in report.html.
SAVE_ANALYSIS_VIDEO=true
# Run the heavier InsightFace identity check once every N seconds of face-visible video.
IDENTITY_SAMPLE_SEC=20
WHISPER_MODEL=base
SAVE_EVIDENCE_FRAMES=true

# ── Output (written to ./output) ─────────────────────────────
OUTPUT_FILE=result.json

# ═════════════════════════════════════════════════════════════
#  EC2 WORKER (production) — used by `python -m worker.worker`
#  (docker-compose local testing ignores everything below)
# ═════════════════════════════════════════════════════════════
AWS_REGION=us-east-1
# https://sqs.us-east-1.amazonaws.com/985100584614/training-analysis-jobs
ANALYSIS_QUEUE_URL=
# Stop this EC2 instance after N minutes with an empty queue (Lambda restarts it per job).
IDLE_MINUTES=10
STOP_WHEN_IDLE=true
# stitch = all recordings of a meeting are parts of one session (sum + union)
# longest = keep the biggest recording, treat short ones as false starts
MERGE_STRATEGY=stitch
# Trainer reference photos ship with the repo in trainer/<Trainer_Name>.png|.jpg
# (folder-style names, e.g. Naghma_Akhtar.png). Only set this to override the location.
# TRAINER_PHOTOS_DIR=/opt/training-audit/trainer
# If OPENAI_API_KEY is empty, the worker reads it from this Secrets Manager secret.
OPENAI_SECRET_NAME=training-analysis/openai
# Local model cache (InsightFace/Whisper download once, survive restarts).
MODEL_CACHE_DIR=/opt/training-audit/.cache
